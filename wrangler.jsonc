{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "molytex",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Static pages from `next build` (out/). Only /api/* runs Worker code; everything else is served as files.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },

  "routes": [
    { "pattern": "molytexproducts.com", "custom_domain": true },
    { "pattern": "www.molytexproducts.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "molytex",
      // Set from the output of `npx wrangler d1 create molytex` (DEPLOY.md step 6).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "send_email": [{ "name": "EMAIL" }],

  // 5 submissions per minute per visitor IP. namespace_id only needs to be unique within the account.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],

  // Secrets (set with `wrangler secret put`, never committed): TURNSTILE_SECRET, NOTIFY_TO.
  "vars": { "MAIL_FROM": "noreply@molytexproducts.com" }
}
